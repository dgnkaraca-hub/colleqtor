{
  "name": "colleqtor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "colleqtor — yaşayan koleksiyon & dijital arşiv (frontend prototype)",
  "scripts": {
    "dev": "vite",
    "images": "node scripts/optimize-images.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "build": "npm run images && npm run sitemap && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.4",
    "vite": "^5.4.6"
  }
}
